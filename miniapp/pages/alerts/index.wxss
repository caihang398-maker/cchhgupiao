.page-head,
.rule-item,
.event-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.add-button {
  width: 126rpx;
  min-height: 72rpx;
  margin: 0;
  color: #1d4ed8;
  background: #ffffff;
  border: 1rpx solid #93c5fd;
  border-radius: 9rpx;
  font-size: 26rpx;
  line-height: 72rpx;
}

.evaluate-button {
  min-height: 80rpx;
  margin: 12rpx 0 0;
  color: #ffffff;
  background: #1d4ed8;
  border-radius: 10rpx;
  font-size: 27rpx;
  line-height: 80rpx;
}

.quick-section {
  margin-top: 22rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.quick-grid button {
  min-width: 0;
  min-height: 70rpx;
  margin: 0;
  padding: 0 8rpx;
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
  border-radius: 9rpx;
  font-size: 24rpx;
  line-height: 70rpx;
}

.rule-item,
.event-item {
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.rule-type {
  font-weight: 700;
}

.rule-target {
  margin-top: 7rpx;
  color: #4b5563;
}

.rule-note,
.event-time {
  margin-top: 7rpx;
  color: #9ca3af;
  font-size: 23rpx;
}

.event-item {
  border-left: 6rpx solid #94a3b8;
}

.event-risk {
  border-left-color: #dc2626;
}

.event-opportunity {
  border-left-color: #059669;
}

.event-head {
  font-weight: 600;
}

.event-message {
  margin-top: 12rpx;
  color: #4b5563;
  line-height: 1.6;
}
