.paper-value {
  font-size: 30rpx;
}

.form-caption {
  margin: 8rpx 0 22rpx;
}

.count-value {
  color: #1d4ed8;
  font-weight: 700;
}

.generate-button {
  width: 100%;
  white-space: nowrap;
}

.trade-item {
  margin-bottom: 14rpx;
  padding: 22rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
}

.trade-name {
  font-size: 30rpx;
  font-weight: 700;
}

.trade-meta,
.trade-foot {
  color: #6b7280;
  font-size: 23rpx;
}

.trade-meta {
  margin-top: 5rpx;
}

.trade-return {
  font-weight: 700;
}

.trade-foot {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f3f4f6;
}

.risk-note {
  margin: 28rpx 0;
  padding: 18rpx 20rpx;
  color: #92400e;
  background: #fffbeb;
  border-left: 6rpx solid #d97706;
  border-radius: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
}
