.subscription-page {
  padding-bottom: calc(54rpx + env(safe-area-inset-bottom));
}

.membership-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx;
  color: #ffffff;
  background: #1f4fbf;
  border-radius: 12rpx;
}

.summary-main {
  min-width: 0;
  flex: 1;
}

.summary-label,
.summary-expiry {
  color: #dbeafe;
  font-size: 23rpx;
  line-height: 1.5;
}

.summary-status {
  margin: 8rpx 0;
  font-size: 40rpx;
  font-weight: 700;
}

.days-box {
  width: 152rpx;
  padding: 18rpx 10rpx;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 10rpx;
  text-align: center;
}

.days-value {
  font-size: 34rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.days-label {
  margin-top: 6rpx;
  color: #dbeafe;
  font-size: 21rpx;
}

.payment-notice,
.identity-note {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  background: #fff7ed;
  border-left: 6rpx solid #d97706;
}

.notice-eligible {
  background: #eff6ff;
  border-left-color: #2563eb;
}

.notice-title {
  font-weight: 700;
}

.notice-text {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.55;
}

.payment-checklist {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(107, 114, 128, 0.2);
}

.checklist-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 7rpx 0;
}

.checklist-state {
  flex: none;
  width: 82rpx;
  color: #9a3412;
  font-size: 22rpx;
  font-weight: 700;
}

.checklist-ready {
  color: #047857;
}

.checklist-label {
  min-width: 0;
  color: #374151;
  font-size: 23rpx;
  line-height: 1.5;
}

.plans-heading {
  margin-top: 34rpx;
}

.plan-item {
  margin-bottom: 18rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.plan-recommended {
  border-color: #60a5fa;
}

.plan-top,
.plan-name-row,
.feature-row {
  display: flex;
}

.plan-top {
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.plan-name-row {
  align-items: center;
  gap: 12rpx;
}

.plan-name {
  font-size: 32rpx;
  font-weight: 700;
}

.recommend-tag {
  padding: 4rpx 9rpx;
  color: #1d4ed8;
  background: #eff6ff;
  border-radius: 5rpx;
  font-size: 20rpx;
}

.plan-duration {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 23rpx;
}

.plan-price {
  color: #b91c1c;
  font-size: 36rpx;
  font-weight: 700;
}

.feature-row {
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.feature-item {
  padding: 6rpx 10rpx;
  color: #374151;
  background: #f3f4f6;
  border-radius: 5rpx;
  font-size: 22rpx;
}

.plan-button {
  min-height: 72rpx;
  margin-top: 22rpx;
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
  border-radius: 9rpx;
  font-size: 26rpx;
  line-height: 72rpx;
}

.identity-note {
  background: #eff6ff;
  border-left-color: #2563eb;
}

.subscription-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.action-button {
  min-width: 0;
  flex: 1;
  margin: 0;
}
