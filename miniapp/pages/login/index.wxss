.login-page {
  min-height: 100vh;
  padding: 110rpx 38rpx 40rpx;
  background: #f4f6f8;
}

.brand-block {
  margin-bottom: 48rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
  background: #1d4ed8;
  border-radius: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.brand-title {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.brand-subtitle {
  margin-top: 12rpx;
  color: #6b7280;
}

.login-panel {
  padding: 30rpx;
  background: #ffffff;
  border: 1rpx solid #d1d5db;
  border-radius: 12rpx;
}

.panel-title {
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.panel-caption {
  margin-bottom: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

.automatic-login-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 190rpx;
}

.login-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid #dbeafe;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: login-spin 0.8s linear infinite;
}

.automatic-login-text {
  margin-top: 22rpx;
  color: #4b5563;
  font-size: 25rpx;
}

@keyframes login-spin {
  to {
    transform: rotate(360deg);
  }
}

.error-message {
  margin: -4rpx 0 20rpx;
  padding: 16rpx 18rpx;
  color: #991b1b;
  background: #fef2f2;
  border-radius: 8rpx;
}

.login-separator {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 22rpx 0;
  color: #9ca3af;
  font-size: 24rpx;
}

.wechat-button {
  min-height: 84rpx;
  color: #047857;
  background: #ecfdf5;
  border: 1rpx solid #6ee7b7;
  border-radius: 10rpx;
  font-size: 29rpx;
  line-height: 84rpx;
}

.risk-caption {
  margin-top: 34rpx;
  color: #6b7280;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}
