# This file is documentation only. The application reads operating-system
# environment variables and does not automatically load this file.

# Local research mode
APP_ENV=local
AUTH_ENABLED=false
PYTHONUTF8=1

# Production member database (required only when AUTH_ENABLED=true)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stock_quant_saas
DB_USER=stock_quant_app
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Initial administrator creation (do not commit real values)
ADMIN_MOBILE=13800000000
ADMIN_REAL_NAME=System Administrator
ADMIN_LOGIN_NAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Optional notification channel
PUSH_WEBHOOK_URL=

# Creem online subscription (keep disabled until test mode is configured)
PAYMENT_ENABLED=false
CREEM_MODE=test
CREEM_TEST_API_KEY=
CREEM_TEST_WEBHOOK_SECRET=
CREEM_LIVE_API_KEY=
CREEM_LIVE_WEBHOOK_SECRET=
CREEM_LIVE_ENABLED=false
CREEM_SUCCESS_URL=http://127.0.0.1:8501/subscription

# Local-only webhook listener. Publish it through an HTTPS reverse proxy.
PAYMENT_WEBHOOK_HOST=127.0.0.1
PAYMENT_WEBHOOK_PORT=8511

# WeChat Mini Program API. Keep AppSecret on the server only.
MINIAPP_API_HOST=127.0.0.1
MINIAPP_API_PORT=8512
MINIAPP_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MINIAPP_TOKEN_DAYS=7
MINIAPP_TRUST_PROXY=false
MINIAPP_ALLOW_LOCAL_DEV=true
MINIAPP_WECHAT_AUTO_REGISTER=false
MINIAPP_WECHAT_TRIAL_DAYS=7
WECHAT_MINIAPP_SUBJECT_TYPE=individual
WECHAT_MINIAPP_CATEGORY_TOOLS=false
WECHAT_MINIAPP_VERIFIED=false
WECHAT_MINIAPP_ICP_FILED=false
MINIAPP_PAYMENT_MODE=disabled
MINIAPP_PAYMENT_LIVE_ENABLED=false
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_VIRTUAL_PAY_OFFER_ID=
WECHAT_VIRTUAL_PAY_APP_KEY=

# CloudBase Run adapter. Keep disabled on the PC and existing Windows server.
MINIAPP_TRUST_CLOUDBASE_IDENTITY=false
MINIAPP_REQUIRE_PERSISTENT_STORAGE=false
STOCK_QUANT_DATA_DIR=
STOCK_QUANT_REPORTS_DIR=
STOCK_QUANT_SQLITE_JOURNAL_MODE=wal
STOCK_QUANT_LOG_STDOUT=false
