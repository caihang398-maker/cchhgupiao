# This file is documentation only. The application reads operating-system
# environment variables and does not automatically load this file.

# Local research mode
APP_ENV=local
AUTH_ENABLED=false
PYTHONUTF8=1

# Production member database (required only when AUTH_ENABLED=true)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stock_quant_saas
DB_USER=stock_quant_app
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Initial administrator creation (do not commit real values)
ADMIN_MOBILE=13800000000
ADMIN_REAL_NAME=System Administrator
ADMIN_LOGIN_NAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Optional notification channel
PUSH_WEBHOOK_URL=
