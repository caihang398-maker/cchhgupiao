.record-item {
  margin-top: 16rpx;
  padding: 24rpx;
}

.record-title {
  min-width: 0;
  flex: 1;
  font-size: 29rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.record-date,
.record-category {
  color: #6b7280;
  font-size: 22rpx;
}

.record-category {
  margin-top: 10rpx;
}

.record-summary {
  margin-top: 14rpx;
  color: #374151;
  font-size: 25rpx;
  line-height: 1.55;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
