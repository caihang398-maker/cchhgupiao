.score-field {
  margin-bottom: 30rpx;
}

.score-row {
  display: flex;
  gap: 12rpx;
}

.score-button {
  min-width: 0;
  flex: 1;
  margin: 0;
  color: #4b5563;
  background: #ffffff;
  border: 1rpx solid #d1d5db;
  border-radius: 8rpx;
  font-size: 25rpx;
}

.score-active {
  color: #ffffff;
  background: #1d4ed8;
  border-color: #1d4ed8;
}
