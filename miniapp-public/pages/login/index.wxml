<view class="login-page">
  <view class="brand-mark">复</view>
  <view class="brand-title">个人复盘助手</view>
  <view class="brand-subtitle">无需登录即可使用本机记录功能。登录仅用于识别你的微信账号，不申请手机号、头像或昵称。</view>

  <view wx:if="{{error}}" class="error-notice">{{error}}</view>
  <view class="privacy-tip" bindtap="toggleAgreement">
    <view class="agreement-checkbox {{agreed ? 'agreement-checked' : ''}}">{{agreed ? '✓' : ''}}</view>
    <text>我已阅读并同意</text>
    <text class="link" catchtap="openAgreement">《用户服务协议》</text>
    和
    <text class="link" catchtap="openPrivacy">《隐私保护说明》</text>
  </view>
  <button class="primary-button login-button" loading="{{loading}}" bindtap="login">{{loading ? '正在连接服务...' : '微信账号登录（可选）'}}</button>
  <button class="secondary-button guest-button" bindtap="continueAsGuest">暂不登录，继续体验</button>
</view>
