.legal-section {
  margin-top: 20rpx;
  padding: 26rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 9rpx;
}

.legal-text {
  margin-top: 12rpx;
  color: #4b5563;
  font-size: 25rpx;
  line-height: 1.75;
}

.contact-button {
  margin-top: 28rpx;
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
  border-radius: 8rpx;
  font-size: 25rpx;
}
