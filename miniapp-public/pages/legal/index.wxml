<view class="page">
  <view class="page-title">{{title}}</view>
  <view class="page-subtitle">更新日期：2026年09月11日</view>
  <view wx:for="{{sections}}" wx:key="title" class="legal-section">
    <view class="section-title">{{item.title}}</view>
    <view class="legal-text">{{item.text}}</view>
  </view>
  <button class="contact-button" open-type="contact">联系小程序客服</button>
</view>
