page {
  min-height: 100%;
  color: #111827;
  background: #f4f6f8;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 34rpx 28rpx calc(44rpx + env(safe-area-inset-bottom));
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-subtitle,
.caption {
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.6;
}

.page-subtitle {
  margin-top: 10rpx;
}

.section {
  margin-top: 28rpx;
}

.panel,
.record-item,
.metric {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
}

.panel {
  padding: 26rpx;
}

.section-heading,
.row,
.record-head,
.profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.metric {
  min-width: 0;
  padding: 22rpx;
}

.metric-label {
  color: #6b7280;
  font-size: 23rpx;
}

.metric-value {
  margin-top: 9rpx;
  font-size: 36rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.primary-button,
.secondary-button,
.danger-button {
  min-height: 78rpx;
  border-radius: 8rpx;
  font-size: 27rpx;
  line-height: 78rpx;
}

.primary-button {
  color: #ffffff;
  background: #1d4ed8;
  border: 1rpx solid #1d4ed8;
}

.secondary-button {
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
}

.danger-button {
  color: #b91c1c;
  background: #ffffff;
  border: 1rpx solid #fecaca;
}

.empty,
.notice,
.error-notice {
  margin-top: 22rpx;
  padding: 24rpx;
  border-left: 6rpx solid #2563eb;
  border-radius: 8rpx;
  font-size: 25rpx;
  line-height: 1.6;
}

.empty,
.notice {
  color: #1e3a8a;
  background: #eff6ff;
}

.error-notice {
  color: #991b1b;
  background: #fef2f2;
  border-left-color: #dc2626;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.field-input,
.field-textarea,
.picker-value {
  width: 100%;
  padding: 20rpx 22rpx;
  background: #ffffff;
  border: 1rpx solid #d1d5db;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.field-textarea {
  min-height: 160rpx;
  line-height: 1.6;
}

.link-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}

.link-row:last-child {
  border-bottom: none;
}

.link-arrow {
  color: #9ca3af;
  font-size: 34rpx;
}
